{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist-electron",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src-electron/**/*", "types/tracking.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "src-electron/**/*.test.ts"
  ]
}
