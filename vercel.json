{
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/check-youtube", "destination": "/api/check-youtube" },
    { "source": "/api/:path*", "destination": "https://api.oeyo-cam.site/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
