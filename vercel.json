{
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path((?!check-youtube$|ai-interpret$|youtube-search$|onboarding-chat$).*)", "destination": "https://api.oeyo-cam.site/:path" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
