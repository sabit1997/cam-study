{
  "name": "cam-study",
  "version": "1.1.12",
  "private": true,
  "description": "외요의 캠스터디 데스크탑 앱",
  "author": "OEYO <yejiii1997@gmail.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:web": "vite",
    "build:ts": "esbuild src-electron/main.ts src-electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:fsevents --outdir=dist-electron",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev": "npm run build:ts && concurrently -k \"npm run dev:web\" \"npm run dev:electron\"",
    "build:web": "vite build",
    "build:app": "npm run build:ts && npm run build:web && electron-builder",
    "type-check": "tsc --noEmit",
    "type-check:electron": "tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src components apis stores hooks utils",
    "test": "vitest run",
    "check": "npm run type-check && npm run type-check:electron && npm run lint && npm test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.74.3",
    "@uiw/react-color": "^2.5.4",
    "axios": "^1.8.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "qs": "^6.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.2",
    "react-icons": "^5.5.0",
    "react-rnd": "^10.5.2",
    "react-router-dom": "7.18.2",
    "react-youtube": "^10.1.0",
    "recharts": "^3.9.1",
    "sonner": "^2.0.7",
    "use-debounce": "^10.0.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@tanstack/react-query-devtools": "^5.74.4",
    "@types/express": "^5.0.6",
    "@types/http-proxy-middleware": "^0.19.3",
    "@types/node": "^20.19.8",
    "@types/qs": "^6.9.18",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.7.1",
    "@types/youtube": "^0.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/node": "^5.9.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.oeyocam.desktop",
    "productName": "외요의 캠스터디",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "package.json",
      "dist-electron/**/*",
      "dist/**/*"
    ],
    "asarUnpack": [
      "dist/**/*"
    ],
    "directories": {
      "buildResources": "buildResources"
    },
    "afterPack": "./scripts/afterPackMac.js",
    "mac": {
      "icon": "buildResources/icon.icns",
      "identity": null,
      "artifactName": "cam-study-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "buildResources/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "CamStudySetup.exe"
    },
    "dmg": {
      "artifactName": "CamStudySetup.dmg",
      "title": "외요의 캠스터디"
    },
    "linux": {
      "icon": "buildResources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sabit1997",
        "repo": "cam-study",
        "releaseType": "release"
      }
    ]
  }
}
