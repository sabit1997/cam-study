# 앱 모드 — "server": 백엔드 인증까지 붙은 원래 동작 (현재는 사용 안 함).
# "local" (기본 배포): 로그인 없이 localStorage/electron-store로 도메인 데이터를 저장.
#                       AI 기능은 Vercel 서버리스 함수로 프록시되어 여전히 동작한다.
# 빌드타임에 결정되므로 값을 바꾼 뒤 반드시 재빌드해야 한다.
VITE_APP_MODE=local

# YouTube Data API v3 키 — 영상 임베드 가능 여부와 제목 조회에 쓴다.
# 개발: Vite 미들웨어가 읽는다 / 데스크탑 빌드: esbuild가 번들에 주입한다 (안전).
YOUTUBE_API_KEY=

# Google Gemini API 키 — 자연어 명령을 액션으로 옮기는 데 쓴다 (server/ai-interpret.ts).
# https://aistudio.google.com/apikey 에서 발급한다.
# 개발(Vite)과 웹 배포(Vercel 환경변수)에서만 필요하다.
# 데스크탑 빌드에는 절대 주입하지 않는다. 배포 바이너리에서 꺼내볼 수 있기 때문이다.
GEMINI_API_KEY=

# 사용할 모델 (선택). 비워두면 gemini-2.5-flash-lite를 쓴다.
# 무료 티어는 모델별 일일 요청 한도가 있다.
GEMINI_MODEL=

# Cloudflare Turnstile secret key — 서버 전용. Vercel Environment Variables에만 넣는다.
# 브라우저 요청(Origin 있음)의 봇 검증 토큰을 siteverify로 확인하는 데 쓴다.
# https://developers.cloudflare.com/turnstile/get-started/ 에서 발급.
# 미설정 시 프로덕션 서버가 fail-closed로 동작해 브라우저에서 오는 AI 요청이 모두 403이 된다.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key — 프론트 노출. VITE_ 접두어로 Vite가 번들에 주입한다.
# secret key와 페어. 대시보드 위젯 상세에서 함께 발급된다.
# 미설정 시 브라우저 위젯이 마운트되지 않아 토큰 없이 AI 호출 → 서버 403.
VITE_TURNSTILE_SITE_KEY=

# /api/ai-interpret 등을 브라우저에서 호출해도 되는 오리진 (선택, 쉼표 구분).
# 비워두면 https://www.oeyo-cam.site,https://oeyo-cam.site 를 쓴다.
# Vercel 프리뷰 배포에서 AI를 써야 하면 그 주소를 여기에 추가한다.
ALLOWED_ORIGINS=

# 데스크탑 앱이 AI 요청을 넘길 웹 배포본 주소 (예: https://www.oeyo-cam.site)
# 비워두면 데스크탑에서 AI 명령이 동작하지 않는다. 키가 아니라 주소이므로 번들에 들어가도 안전하다.
# release.yml에서는 이미 하드코딩돼 있다.
AI_PROXY_URL=
